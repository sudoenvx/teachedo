{
  "name": "teachedo",
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build --parallel",
    "typecheck": "turbo run typecheck --parallel",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint --parallel",

    "sandbox:build": "turbo run build --filter=@teachedo/api-sandbox",
    "sandbox:start": "pnpm --filter api-sandbox start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.13.4",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3"
  }
}
