// =============================================================
// Module B: Tenants (Teachers & Staff)
// =============================================================

model Teacher {
  id                     Int      @id @default(autoincrement())
  fullName               String   @map("full_name") @db.VarChar(100)
  username               String   @unique @db.VarChar(50)
  email                  String?  @unique @db.VarChar(255)
  password               String   @db.VarChar(255)
  phoneNumber            String?  @unique @map("phone_number") @db.VarChar(20)
  subjectSpecialization  String?  @map("subject_specialization") @db.VarChar(100)
  accountStatus          String?  @map("account_status") @db.VarChar(20) // active, suspended_payment, inactive...
  profilePictureUrl      String?  @map("profile_picture_url") @db.VarChar(255)
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")
  onboardingPolicyKey    String?  @map("onboarding_policy_key") @db.VarChar(100)
  onboardingPolicyVersion Int?    @map("onboarding_policy_version")
  createdAt              DateTime @default(now()) @map("created_at")

  // Reverse relations — every table scoped by teacher_id points back here.
  assistants       TeacherAssistant[]
  billingCycles    PlatformBillingCycle[]
  platformPayments PlatformPayment[]
  studyStages      StudyStage[]
  students         Student[]
  studentGroups    StudentGroup[]
  classSessions    ClassSession[]
  attendance       Attendance[]
  lessons          Lesson[]
  questionBank     QuestionBank[]
  subjects         TeacherSubject[]
//   quizzes          Quiz[]
  studentInvoices  StudentInvoice[]
  studentPayments  StudentPayment[]
//   notifications    Notification[]

  @@map("teachers")
}

model TeacherAssistant {
  id          Int      @id @default(autoincrement())
  teacherId   Int      @map("teacher_id")
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  fullName    String   @map("full_name") @db.VarChar(100)
  username    String   @unique @db.VarChar(50)
  email       String?  @unique @db.VarChar(255)
  password    String   @db.VarChar(255)
  phoneNumber String?  @map("phone_number") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  // NOTE: no `permissions Json` column here anymore — permissions live
  // exclusively in AssistantPermission below, so there's a single source
  // of truth instead of a JSON blob that can drift from the normalized table.
  permissions AssistantPermission[]

  @@map("teacher_assistants")
}

// The catalog of every valid permission key in the system.
model Permission {
  id            Int    @id @default(autoincrement())
  key String @unique @map("permission_key") @db.VarChar(50) // e.g. 'finance_view', 'attendance_write'
  label         String? @db.VarChar(100) // e.g. "Manage Finance"

  assistants AssistantPermission[]

  @@map("permissions")
}

// Pure junction table — no duplicated label text, unlike the original draft.
model AssistantPermission {
  assistantId  Int              @map("assistant_id")
  assistant    TeacherAssistant @relation(fields: [assistantId], references: [id])
  permissionId Int              @map("permission_id")
  permission   Permission       @relation(fields: [permissionId], references: [id])

  @@id([assistantId, permissionId])
  @@map("assistant_permissions")
}
