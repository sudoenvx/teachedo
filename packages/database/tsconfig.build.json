{
  "extends": "./tsconfig.json",
  
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "incremental": false,
    "composite": false
  },
  "include": [
    "src/**/*",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "prisma",
    "src/generated"
  ]
}
