{
  "extends": "@teachedo/tsconfig/react-library.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "./src",
    "resolvePackageJsonImports": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@teachedo/ui": ["./src/index.ts"],
      "@teachedo/theme": ["../theme/src/index.ts"],
      "@teachedo/utils": ["../utils/src/index.ts"]
    }
  },
  "references": [
    { "path": "../theme" },
    { "path": "../utils" }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist"
  ]
}
