{
  "extends": "@teachedo/tsconfig/library.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "esnext", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
